---
layout: blog-base.njk
title: Blog
description: Updates from Rhiza Research on open technology, energy, and weather intelligence.
permalink: /blog/
---
<section class="main blog-listing">
	<header class="major">
		<h1>Rhiza thoughts and updates</h1>
	</header>

	{% if collections.posts and collections.posts.length %}
	<ul class="blog-cards">
		{% for post in collections.posts %}
		<li>
			<article class="blog-card">
				<a href="{{ post.url | url }}">
					{% if post.data.cover %}
					<span class="blog-card-image">
						<img src="{{ post.data.cover | url }}" alt="" />
					</span>
					{% endif %}
					<div class="blog-card-body">
						<h2>{{ post.data.title }}</h2>
						<p class="blog-card-date">
							<time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
						</p>
						{% if post.data.description %}
						<p class="blog-card-excerpt">{{ post.data.description }}</p>
						{% endif %}
						<span class="blog-card-cta">Read more &rarr;</span>
					</div>
				</a>
			</article>
		</li>
		{% endfor %}
	</ul>
	{% else %}
	<p class="blog-empty">No posts yet. Check back soon.</p>
	{% endif %}
</section>
